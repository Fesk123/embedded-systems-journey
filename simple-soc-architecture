                    ┌─────────────┐
                    │     BUS     │
                    └──────┬──────┘
                           │
             ┌─────────────┼─────────────┐
             │             │             │
             ▼             ▼             ▼
           RAM            UART          GPIO
                           │
                           ▼
                         Timer
                           │
                           ▼
                      Interrupt
                           │
                           └────────────► CPU

